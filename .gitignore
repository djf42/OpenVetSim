*.swo

# ── Claude Cowork internal ────────────────────────────────────────────────────
.claude/
.skills/

# ── Code-signing material — MUST NEVER be committed ───────────────────────────
# Certificates/ holds developer_id.key, the Apple signing private key.
Certificates/
*.key
*.cer
*.csr
*.p12
*.pfx

# ── Reference copies of upstream repos (not part of this project) ──────────────
# Kept locally for diffing against the pre-migration code; not ours to vendor.
WinVetSim-master/
WinVetSim-master.zip
sim-ctl-master.zip

# ── Runtime logs, recordings and scratch ──────────────────────────────────────
simlogs/
debian@*

